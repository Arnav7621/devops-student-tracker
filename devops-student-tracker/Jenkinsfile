pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = 'arnav71'
        IMAGE_NAME         = 'devops-student-tracker'
        IMAGE_TAG          = "${BUILD_NUMBER}"
        DOCKER_CREDS_ID    = 'dockerhub-creds'
    }

    options {
        timeout(time: 40, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Test & Quality Gate') {
            steps {
                dir('devops-student-tracker') {
                    sh '''
                        set -e
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install -r requirements-dev.txt
                        pytest tests/ -v --junitxml=test-results.xml
                    '''
                }
            }
            post {
                always {
                    junit testResults: 'devops-student-tracker/test-results.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('devops-student-tracker') {
                    sh '''
                        set -e
                        docker build \
                          -t ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG} \
                          -t ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest .
                    '''
                }
            }
        }

        stage('Docker Hub Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.DOCKER_CREDS_ID,
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        set -e
                        echo "$DOCKER_PASS" | docker login \
                          -u "$DOCKER_USER" --password-stdin
                        docker push "${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG}"
                        docker push "${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest"
                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "CI successful: ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo 'Pipeline failed. Review the stage logs.'
        }
        always {
            cleanWs deleteDirs: true, notFailBuild: true
        }
    }
}
